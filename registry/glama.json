{
  "$schema": "https://glama.ai/mcp/schema/v1/manifest.json",
  "name": "agentmesh-suite",
  "title": "AgentMesh Runtime Suite",
  "description": "Deterministic microservice runtime mesh for AI coding agents exposing 26 MCP tools across 7 high-performance Rust & Go engines.",
  "version": "1.0.0",
  "website": "https://s6pa1rta3n-lab.github.io/agentmesh-site/",
  "repository": "https://github.com/s6pa1rta3n-lab",
  "license": "Apache-2.0",
  "categories": [
    "Developer Tools",
    "AI Coding Agents",
    "Code Intelligence",
    "Sandboxing",
    "Testing & QA",
    "Security"
  ],
  "servers": {
    "symbol-graph": {
      "command": "symbol-graph-svc",
      "args": ["--mcp-stdio"],
      "description": "High-throughput AST symbol indexing, definition lookup, and cross-file call graphs.",
      "tools": [
        "symbol_graph_index_workspace",
        "symbol_graph_find_definition",
        "symbol_graph_find_references",
        "symbol_graph_build_call_graph"
      ]
    },
    "sandbox-pool": {
      "command": "sandbox-pool-svc",
      "args": ["--mcp-stdio"],
      "description": "Ephemeral copy-on-write workspace scratchpads, sub-second execution, snapshots & diffs.",
      "tools": [
        "sandbox_pool_create",
        "sandbox_pool_execute",
        "sandbox_pool_snapshot",
        "sandbox_pool_diff",
        "sandbox_pool_destroy"
      ]
    },
    "test-oracle": {
      "command": "python3",
      "args": ["-m", "test_oracle.mcp_server"],
      "description": "Dynamic test impact analysis and automated git commit bisection.",
      "tools": [
        "test_oracle_analyze_impact",
        "test_oracle_run_bisect",
        "test_oracle_detect_flakiness"
      ]
    },
    "ast-patcher": {
      "command": "ast-patcher-svc",
      "args": ["--mcp-stdio"],
      "description": "Deterministic AST-aware code transformation, refactoring, and atomic rollback.",
      "tools": [
        "ast_patcher_apply_patch",
        "ast_patcher_rename_symbol",
        "ast_patcher_validate_syntax"
      ]
    },
    "episodic-memory": {
      "command": "python3",
      "args": ["-m", "episodic_memory.mcp_server"],
      "description": "Semantic knowledge graph, episodic experience recording, and cross-session memory.",
      "tools": [
        "episodic_memory_store",
        "episodic_memory_query",
        "episodic_memory_graph_link",
        "episodic_memory_graph_query"
      ]
    },
    "visual-eval": {
      "command": "node",
      "args": ["dist/mcp-server.js"],
      "description": "Headless browser DOM layout inspection, visual regression pixel-diffing & a11y audits.",
      "tools": [
        "visual_eval_render_page",
        "visual_eval_diff_snapshots",
        "visual_eval_check_a11y"
      ]
    },
    "safety-broker": {
      "command": "safety-broker-svc",
      "args": ["--mcp-stdio"],
      "description": "Deny-by-default policy enforcement, secret vault proxying, and Merkle audit logs.",
      "tools": [
        "safety_broker_evaluate_action",
        "safety_broker_get_credential",
        "safety_broker_audit_log",
        "safety_broker_verify_victory"
      ]
    }
  },
  "pricing": {
    "model": "metered",
    "settlementRails": "Base L2 USDC",
    "depositAddress": "0xF46C9F6d70C50BF81ef3588AB523a90a594a2F89",
    "plans": {
      "community": { "price": 0, "currency": "USD" },
      "managed": { "price": 29, "period": "month", "currency": "USD" },
      "enterprise": { "price": 299, "period": "pack", "currency": "USD" }
    }
  }
}
